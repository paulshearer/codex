{
  "manifest_version": 3,
  "name": "Codex Permissive Browser",
  "version": "1.0.0",
  "description": "Attach signed-in browser tabs to your standalone local agent.",
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect to Codex Permissive"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "key": ""
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Permissive",
  "version": "1.0.0",
  "identifier": "com.codex-permissive.desktop",
  "build": { "frontendDist": "../desktop/dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Codex Permissive", "width": 1180, "height": 820, "minWidth": 760, "minHeight": 540, "create": false, "devtools": false, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
